# disable grid
--style="numbers,changes,header"
# C++ syntax (instead of C) for .h header files
--map-syntax=*.h:C++
# Use .ini format for .conf files
--map-syntax=*.conf:INI
# Use .ini format for systemd .service files
--map-syntax=*.service:INI
# Use make format for justfiles
--map-syntax=justfile:Makefile
# Use HCL for HOCON (maybe nginx is better?)
--map-syntax=*.hocon:Terraform
# Display tabs as 2 spaces
--tabs=2
